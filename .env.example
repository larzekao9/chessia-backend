# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - BRAZO ROBÓTICO CON IA PARA AJEDREZ (KAIROS CORE)
# Copiar este archivo a '.env' y ajustar las credenciales según el entorno local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL - pgAdmin local / Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ajedrez

# URL de conexión SQLAlchemy consumida por el backend FastAPI
DATABASE_URL=postgresql+psycopg2://postgres:tu_password_aqui@localhost:5432/ajedrez

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------------------------
# Obligatoria en el servidor. Generar una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin ella el backend usa una clave al azar por arranque y las sesiones se pierden al reiniciar.
JWT_SECRET_KEY=tu_clave_secreta_jwt_para_firmar_tokens
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Orígenes que pueden llamar a la API desde un navegador, separados por coma (por ejemplo, el dominio publicado).
# Vacío = cualquiera (sirve en local; en producción conviene fijarlo).
CORS_ORIGINS=
# La política de contenido del navegador bloquea lo no autorizado. Si una pantalla dejara de cargar algo, poné 1 para que solo avise
# (se ve en la consola del navegador) y reiniciá.
CSP_SOLO_INFORMAR=

# Desactivar siempre en un servidor publicado: los tokens demo/mock solo sirven para desarrollo local.
PERMITIR_LOGIN_GOOGLE_DEMO=false

# Verificación del correo y recuperación de contraseña (códigos de 6 dígitos). Solo se activa si SMTP_HOST y SMTP_REMITENTE están definidos; sin ellos,
# el sistema funciona igual y las cuentas nuevas quedan verificadas. Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, el correo
# en SMTP_USUARIO y una «contraseña de aplicación» (no la de la cuenta) en SMTP_CLAVE.
# Verificación en dos pasos (app de códigos como Google Authenticator) de los facilitadores. Cada uno puede activarla en Mi Perfil. Con
# DOBLE_FACTOR_OBLIGATORIO=1 se EXIGE a la plataforma y a los administradores de institución: sin activarla no pueden usar el sistema
# (solo ver su perfil y activarla). Activala recién cuando tu cuenta ya la tenga puesta. Requiere una JWT_SECRET_KEY fija.
DOBLE_FACTOR_OBLIGATORIO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=
# Los cursos que restringen un dominio exigen comprobar la propiedad del correo (Google o código), incluso para cuentas antiguas.
# Las cuentas sin correo creadas por el docente no necesitan SMTP.

# ------------------------------------------------------------------------------
# 3. CONTROL DE ROLES Y PRIVILEGIOS DE FACILITADOR
# ------------------------------------------------------------------------------
# Para registrarse como Facilitador hay que presentar un CÓDIGO DE INVITACIÓN que genera otro facilitador
# desde Gestión de Usuarios (un solo uso, vence a los 15 minutos por defecto). No hay PIN fijo.
#
# Correos que pueden registrarse como Facilitador SIN código, separados por coma. Sirve solo para crear el
# primer facilitador de una instalación nueva (nadie existe todavía para generar un código); después se puede
# dejar vacío. Acepta patrones, por ejemplo *@miuniversidad.edu. No hay ningún correo autorizado de fábrica.
CORREOS_FACILITADORES=tu_correo_de_administrador@ejemplo.com

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH 2.0 (Google Identity Services)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. SERVICIOS COMPLEMENTARIOS (OPCIONALES)
# ------------------------------------------------------------------------------
# Ruta al motor Stockfish si se instala externamente
# STOCKFISH_PATH=C:/Program Files/Stockfish/stockfish.exe

# Origen de captura de cámara para visión por computadora (índice o URL RTSP/HTTP)
CAMARA_FUENTE=0

# ------------------------------------------------------------------------------
# 6. TUTOR TURING (Groq API — GroqCloud, tier gratuito)
# ------------------------------------------------------------------------------
# Generar la key en https://console.groq.com (API Keys). Confirmar en
# https://console.groq.com/docs/models que el modelo sigue disponible y
# soporta tool calling antes de desplegar — el catálogo de Groq cambia seguido.
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# 7. PANEL DE ENTRENAMIENTO DEL FACILITADOR (HU4 — dataset, no el reentrenamiento en sí)
# ------------------------------------------------------------------------------
# Cuántas partidas válidas nuevas hacen falta para que el panel marque "listo para
# entrenar" (ver docs/plan_sprints.md, HU4: "después de N partidas (ej. 10)").
UMBRAL_PARTIDAS_ENTRENAMIENTO=10

# ------------------------------------------------------------------------------
# 8. PRODUCCIÓN (Supabase u otra base gestionada) — ver docs/base_de_datos/DESPLIEGUE_SUPABASE.md
# ------------------------------------------------------------------------------
# Los usuarios de prueba (facilitador@test.com, jugador@test.com...) tienen contraseñas
# fijas conocidas. Se crean al arrancar salvo en bases *.supabase.co / *.supabase.com.
# En cualquier despliegue real dejar esta variable en false.
# SEMBRAR_USUARIOS_PRUEBA=false
#
# Ejemplo de DATABASE_URL para Supabase (Session pooler, IPv4). Reemplazar <ref>, <region>
# y <PASSWORD> (con caracteres especiales codificados, ej. @ -> %40):
# DATABASE_URL=postgresql+psycopg2://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# En producción CORREOS_FACILITADORES debe listar solo correos reales (sin facilitador@test.com ni
# patrones como *@test.com).
