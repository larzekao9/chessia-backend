# Entornos virtuales y secretos
.venv/
venv/
__pycache__/
*.pyc
.env
.env.*
!.env.example
.envdoc.txt


# Configuración local personal (no compartida)
.claude/settings.local.json

# Datasets y checkpoints — no se commitean (ver las reglas del proyecto)
*.pgn
*.pgn.zst
training/checkpoints/
training/dataset_tablero/

# Frontend (React/Vite)
frontend/node_modules/
frontend/dist/

# App móvil (Flutter)
app_movil/
app_movil/.flutter-plugins
app_movil/.flutter-plugins-dependencies
app_movil/build/

# Binarios de terceros descargados localmente (ej. Stockfish, sin necesitar
# admin para instalarlo) — cada quien lo baja con su propio script, no se commitea
tools/

# Contenido subido por facilitadores (videos educativos por pieza) — no es
# código, no se commitea
backend/media/videos_piezas/*
!backend/media/videos_piezas/.gitkeep

# Imágenes de medallas subidas por el facilitador principal — no es código, no se commitea
backend/media/medallas/*
!backend/media/medallas/.gitkeep

# Fotos de perfil subidas por los usuarios — no es código, no se commitea
backend/media/avatares/*
!backend/media/avatares/.gitkeep

# Sistema
.DS_Store

# Caches de test
.pytest_cache/
.tmp-apariencia/

# front_app
front_app/node_modules
front_app/dist

# Bases de datos locales y checkpoints sueltos (no se commitean)
*.db
*.pt
graphify-out/
app_movil/.flutter-plugins-dependencies*
.codex/
.agents/

# Volcados de caída de la JVM (Gradle/Android Studio) y salida de compilación de Android
hs_err_pid*.log
replay_pid*.log
app_movil/android/build/

# Material personal de estudio (no forma parte del código ni de la documentación formal)
docs/guia_de_estudio_turing.md

# Capturas de diseño de la app (referencia visual, no es código)
imgapp/
training/dataset_valor/

# Calibración propia de cada instalación (esquinas del tablero en la foto de la cámara fija)
calibracion_local/
training/dataset_propio/

training/dataset_propio_cuadros/
training/dataset_propio_ampliado/
training/dataset_propio_volumen/

# ZIP de fotos para Colab (scripts/exportar_zip_colab.py): son del dataset propio, no se versionan
training/exportaciones_colab/
